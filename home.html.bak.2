  <script>
    // ===== MOBILE HERO CAROUSEL =====
    let heroCurrentSlide = 0;
    const heroTrack = document.querySelector('.hero-track');
    const heroDots = document.querySelectorAll('.hero-dots .dot');
    const heroButtons = document.querySelectorAll('.hero-nav .hero-btn');
    const heroTotal = 5;

    function updateHeroCarousel() {
      if (heroTrack) {
        heroTrack.style.transform = `translateX(-${heroCurrentSlide * 100}%)`;
      }
      heroDots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === heroCurrentSlide);
      });
    }

    // Hero buttons
    heroButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        heroCurrentSlide = idx === 0 ? (heroCurrentSlide - 1 + heroTotal) % heroTotal : (heroCurrentSlide + 1) % heroTotal;
        updateHeroCarousel();
      });
    });

    // Hero dots click
    heroDots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        heroCurrentSlide = idx;
        updateHeroCarousel();
      });
    });

    // Hero auto-advance
    let heroInterval = setInterval(() => {
      heroCurrentSlide = (heroCurrentSlide + 1) % heroTotal;
      updateHeroCarousel();
    }, 4000);

    // Reset interval on manual interaction
    [...heroButtons, ...heroDots].forEach(el => {
      el.addEventListener('click', () => {
        clearInterval(heroInterval);
        heroInterval = setInterval(() => {
          heroCurrentSlide = (heroCurrentSlide + 1) % heroTotal;
          updateHeroCarousel();
        }, 4000);
      });
    });

    // Mobile Implementation
    let peaceCurrentSlide = 0;
    const peaceTrack = document.querySelector('.peace-mobile .peace-track');
    const peaceButtons = document.querySelectorAll('.peace-mobile .peace-nav button');
    const peaceSlides = document.querySelectorAll('.peace-mobile .peace-slide');
    const peaceTotal = peaceSlides.length;

    function updatePeaceSlide() {
      if (peaceTrack) {
        peaceTrack.style.transform = `translateX(-${peaceCurrentSlide * 100}%)`;
      }
    }

    if (peaceButtons.length > 0) {
      peaceButtons.forEach((btn, idx) => {
        btn.addEventListener('click', () => {
          // Check if it's prev (0) or next (1) button
          // The HTML has 2 buttons in .peace-nav. First is prev, second is next.
          // Note: The previous code assumed index 0 is prev ? No, let's check legacy code.
          // Legacy code: idx === 0 ? (back) : (forward).
          // But wait, are there always exactly 2 buttons? Yes in HTML: <button>‹</button><button>›</button>
          if (idx === 0) {
            peaceCurrentSlide = (peaceCurrentSlide - 1 + peaceTotal) % peaceTotal;
          } else {
            peaceCurrentSlide = (peaceCurrentSlide + 1) % peaceTotal;
          }
          updatePeaceSlide();
        });
      });
    }

    // Peace auto-advance
    let peaceInterval = setInterval(() => {
      peaceCurrentSlide = (peaceCurrentSlide + 1) % peaceTotal;
      updatePeaceSlide();
    }, 5000);

    // Reset on button click
    if (peaceButtons.length > 0) {
      peaceButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          clearInterval(peaceInterval);
          peaceInterval = setInterval(() => {
            peaceCurrentSlide = (peaceCurrentSlide + 1) % peaceTotal;
            updatePeaceSlide();
          }, 5000);
        });
      });
    }

    // PC Implementation (Updated selector to match new inspiration structure)
    (function () {
      let pcCurrentSlide = 0;
      const pcTrack = document.querySelector('#inspiration-pc .peace-track');
      const pcButtons = document.querySelectorAll('#inspiration-pc .peace-nav button');
      const pcSlides = document.querySelectorAll('#inspiration-pc .peace-slide');
      const pcTotal = pcSlides.length;

      function updatePcSlide() {
        if (pcTrack) {
          pcTrack.style.transform = `translateX(-${pcCurrentSlide * 100}%)`;
        }
      }

      if (pcButtons.length > 0) {
        pcButtons.forEach((btn, idx) => {
          btn.addEventListener('click', () => {
            if (idx === 0) {
              pcCurrentSlide = (pcCurrentSlide - 1 + pcTotal) % pcTotal;
            } else {
              pcCurrentSlide = (pcCurrentSlide + 1) % pcTotal;
            }
            updatePcSlide();
          });
        });
      }

      // PC Auto-advance
      let pcInterval = setInterval(() => {
        pcCurrentSlide = (pcCurrentSlide + 1) % pcTotal;
        updatePcSlide();
      }, 5000);

      if (pcButtons.length > 0) {
        pcButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            clearInterval(pcInterval);
            pcInterval = setInterval(() => {
              pcCurrentSlide = (pcCurrentSlide + 1) % pcTotal;
              updatePcSlide();
            }, 5000);
          });
        });
      }
    })();





    // ===== RANGE CAROUSEL SWIPE =====
    const scrollRows = document.querySelectorAll('.scroll-row');
    scrollRows.forEach(scrollRow => {
      let startX = 0;
      scrollRow.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
      });
      scrollRow.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        const diff = startX - endX;
        if (Math.abs(diff) > 50) {
          scrollRow.scrollBy({
            left: diff > 0 ? 200 : -200,
            behavior: 'smooth'
          });
        }
      });
    });

    // Filter buttons
    document.querySelectorAll('.tabs span').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tabs span').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
      });
    });

    // Category filter buttons
    document.querySelectorAll('.icon-box').forEach(box => {
      box.addEventListener('click', () => {
        document.querySelectorAll('.icon-box').forEach(b => b.classList.remove('active'));
        box.classList.add('active');
      });
    });


    // ===== LOGIN CHECKS FOR ALL INTERACTIVE BUTTONS (MOBILE & PC) =====
    function enforceLoginOnButtons(container) {
      const likeBtns = container.querySelectorAll('.like-btn');
      const buyBtns = container.querySelectorAll('.buy-btn');
      const cartBtns = container.querySelectorAll('.add-to-cart');
      likeBtns.forEach(btn => {
        btn.onclick = (e) => {
          const token = localStorage.getItem('token');
          if (!token) {
            window.location.href = 'login-signup.html';
            return false;
          }
          // Like logic (toggle like, update tray)
          btn.classList.toggle('liked');
          // ...update liked tray logic here...
        };
      });
      buyBtns.forEach(btn => {
        btn.onclick = (e) => {
          const token = localStorage.getItem('token');
          if (!token) {
            window.location.href = 'login-signup.html';
            return false;
          }
          // Show custom order form/modal
          alert('Opening order form...');
        };
      });
      cartBtns.forEach(btn => {
        btn.onclick = (e) => {
          const token = localStorage.getItem('token');
          if (!token) {
            window.location.href = 'login-signup.html';
            return false;
          }
          // Add to cart logic (toggle/add, update tray)
          btn.textContent = btn.textContent === 'Add to cart' ? 'Added!' : 'Add to cart';
          // ...update cart tray logic here...
        };
      });
    }

    // Helper: simple mobile check
    function isMobile() {
      return window.innerWidth <= 768;
    }

    // Enforce login on all product cards (PC and mobile) - safe guards for missing mobile helpers
    function enforceLoginAllProductCards() {
      // PC/desktop
      document.querySelectorAll('.products-grid .product-card').forEach(card => enforceLoginOnButtons(card));

      // Mobile rows (dynamically rendered) - fallback to productsGrid when mobile-specific rows aren't present
      if (isMobile()) {
        try {
          if (typeof mobileProductRows !== 'undefined' && mobileProductRows) {
            mobileProductRows.querySelectorAll('.product-card').forEach(card => enforceLoginOnButtons(card));
          } else {
            // fallback: use products grid as scroll row
            const fallback = document.getElementById('productsGrid');
            if (fallback) fallback.querySelectorAll('.product-card').forEach(card => enforceLoginOnButtons(card));
          }
        } catch (e) {
          // ignore errors to avoid stopping other scripts
          console.warn('enforceLoginAllProductCards fallback error', e);
        }
      }
    }

    // Call after rendering mobile rows - only wrap if existing function present
    if (typeof renderMobileRows === 'function') {
      const origRenderMobileRows = renderMobileRows;
      renderMobileRows = function () {
        origRenderMobileRows();
        enforceLoginAllProductCards();
      };
    } else {
      // Provide a safe fallback so other code can call renderMobileRows
      window.renderMobileRows = function () {
        // Ensure products grid behaves as a scroll-row on mobile
        const grid = document.getElementById('productsGrid');
        if (isMobile() && grid) {
          grid.classList.add('product-scroll-row');
          grid.style.display = 'flex';
          grid.style.overflowX = 'auto';
        }
        enforceLoginAllProductCards();
      };
    }

    // Initial enforce
    enforceLoginAllProductCards();
    // ===== HEADER LIKE/CART TRAYS (MOBILE PARITY) =====
    // (Assume PC logic is correct, just ensure mobile header buttons open trays and update content)
    function updateTrayVisibility() {
      if (!isMobile()) {
        document.getElementById('likedTray').style.right = '30px';
        document.getElementById('cartTray').style.right = '370px';
      } else {
        document.getElementById('likedTray').style.right = '20px';
        document.getElementById('cartTray').style.right = '70px';
      }
    }
    window.addEventListener('resize', updateTrayVisibility);
    updateTrayVisibility();

    // WhatsApp/modal logic is already shared, so no change needed for mobile

    // Inner peace carousel
    let peaceIndex = 0;
    document.querySelectorAll('.peace-nav button').forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        peaceIndex = idx === 0 ? (peaceIndex - 1 + 3) % 3 : (peaceIndex + 1) % 3;
        const peaceSlider = document.querySelector('.peace-slider');
        if (peaceSlider) {
          peaceSlider.style.backgroundImage = `url('https://images.unsplash.com/photo-${1600000000 + peaceIndex}?q=80&w=1000')`;
        }
      });
    });
  </script>



