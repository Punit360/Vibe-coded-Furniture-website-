  <script>

    function logout() {
      localStorage.removeItem("token");
      localStorage.removeItem("role");
      window.location.href = "login-signup.html";
    }
    // Add to cart feedback removed as requested

    // Newsletter validation
    document.getElementById('newsletterForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      const note = document.getElementById('newsletterNote');
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!valid) {
        note.style.color = '#c62828';
        note.textContent = 'Please enter a valid email address.';
        return;
      }
      note.style.color = '#2e7d32';
      note.textContent = 'Thanks for subscribing! Check your inbox for a confirmation.';
      this.reset();
    });

    // Hamburger mobile menu
    const hamburger = document.getElementById('hamburger');
    const navMobile = document.getElementById('navMobile');
    hamburger.addEventListener('click', function () {
      navMobile.classList.toggle('open');
      document.body.style.overflow = navMobile.classList.contains('open') ? 'hidden' : '';
      // Animate hamburger icon
      hamburger.classList.toggle('active');
      if (hamburger.classList.contains('active')) {
        hamburger.children[0].style.transform = 'rotate(45deg) translateY(8px)';
        hamburger.children[1].style.opacity = '0';
        hamburger.children[2].style.transform = 'rotate(-45deg) translateY(-8px)';
      } else {
        hamburger.children[0].style.transform = '';
        hamburger.children[1].style.opacity = '';
        hamburger.children[2].style.transform = '';
      }
    });
    // Close mobile nav on link click
    document.querySelectorAll('.mobile-link').forEach(function (link) {
      link.addEventListener('click', function () {
        navMobile.classList.remove('open');
        hamburger.classList.remove('active');
        document.body.style.overflow = '';
        hamburger.children[0].style.transform = '';
        hamburger.children[1].style.opacity = '';
        hamburger.children[2].style.transform = '';
      });
    });

    // Header shadow on scroll
    window.addEventListener('scroll', function () {
      const header = document.querySelector('header');
      if (window.scrollY > 10) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    });

    // Smooth scroll for anchor links (for browsers that don't support scroll-behavior)
    document.querySelectorAll('a[href^="#"]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Animate on scroll (entrance animation)
    function animateOnScroll() {
      document.querySelectorAll('.animate').forEach(function (el) {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight - 60) {
          el.classList.add('visible');
        }
      });
    }
    window.addEventListener('scroll', animateOnScroll);
    window.addEventListener('resize', animateOnScroll);
    window.addEventListener('DOMContentLoaded', animateOnScroll);

    // Like button toggle
    document.querySelectorAll('.like-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var token = localStorage.getItem('token');
        if (!token) {
          window.location.href = 'login-signup.html';
          return;
        }
        btn.classList.toggle('liked');
        btn.setAttribute('aria-pressed', btn.classList.contains('liked') ? 'true' : 'false');
      });
    });
    // Buy button login check
    document.querySelectorAll('.buy-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        var token = localStorage.getItem('token');
        if (!token) {
          window.location.href = 'login-signup.html';
          e.preventDefault();
          return;
        }
        // Place your buy logic here if needed
      });
    });

    // Ensure Add to cart appears before Share
    (function () {
      document.querySelectorAll('.pill.favorite').forEach(function (el) {
        el.remove();
      });
      document.querySelectorAll('.card-actions').forEach(function (actions) {
        const addBtn = actions.querySelector('.add-to-cart');
        const firstPill = actions.querySelector('.pill');
        if (addBtn) {
          if (firstPill && firstPill !== addBtn) {
            actions.insertBefore(addBtn, firstPill);
          } else {
            actions.prepend(addBtn);
          }
        }
      });
    })();

    // Product filter logic (Furniture/CNC sections)
    (function () {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const furnitureSection = document.querySelector('.products-furniture');
      const cncSection = document.querySelector('.products-cnc');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          filterBtns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
          const filter = btn.getAttribute('data-filter');
          if (filter === 'furniture') {
            furnitureSection.style.display = '';
            cncSection.style.display = 'none';
          } else if (filter === 'cnc') {
            furnitureSection.style.display = 'none';
            cncSection.style.display = '';
          }
        });
      });
    })();

    // Furniture tag filter logic
    (function () {
      const filterBtns = document.querySelectorAll('.furn-filter-btn');
      const cards = document.querySelectorAll('.products-furniture .product-card');
      let activeTag = null;
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          const tag = btn.getAttribute('data-furn');
          if (activeTag === tag) {
            // Reset filter
            activeTag = null;
            filterBtns.forEach(b => b.classList.remove('active'));
            cards.forEach(card => card.style.display = '');
          } else {
            activeTag = tag;
            filterBtns.forEach(b => b.classList.toggle('active', b === btn));
            cards.forEach(card => {
              const cardTag = card.getAttribute('data-tags');
              card.style.display = (cardTag === tag) ? '' : 'none';
            });
          }
        });
      });
    })();

    // Show only 8 products by default, expand/collapse logic
    (function () {
      const grid = document.getElementById('productsGrid');
      const moreBtn = document.getElementById('moreProductsBtn');
      const collapseBtn = document.getElementById('collapseBtn');
      let expandedCount = 8;

      function updateGrid(showCount) {
        const cards = grid.querySelectorAll('.product-card');
        cards.forEach((card, idx) => {
          card.style.display = (idx < showCount) ? '' : 'none';
        });
        moreBtn.style.display = (showCount >= cards.length) ? 'none' : '';
        collapseBtn.style.display = (showCount > 8) ? '' : 'none';
        collapseBtn.innerHTML = (showCount > 8) ? '&#x25B2;' : '&#x25BC;';
        collapseBtn.setAttribute('aria-label', (showCount > 8) ? 'Collapse' : 'Expand');
      }

      function resetGrid() {
        expandedCount = 8;
        updateGrid(expandedCount);
      }

      // Initial state
      resetGrid();

      moreBtn.addEventListener('click', function () {
        const cards = grid.querySelectorAll('.product-card');
        expandedCount = Math.min(expandedCount + 8, cards.length);
        updateGrid(expandedCount);
      });

      collapseBtn.addEventListener('click', function () {
        resetGrid();
      });

      collapseBtn.style.display = 'none';

      // Hide/show controls with filter logic
      const furnFilterBtns = document.querySelectorAll('.furn-filter-btn');
      const filterBtns = document.querySelectorAll('.filter-btn');
      function isAnyTagFilterActive() {
        return Array.from(furnFilterBtns).some(btn => btn.classList.contains('active'));
      }
      function isCncFilterActive() {
        return Array.from(filterBtns).some(btn => btn.classList.contains('active') && btn.getAttribute('data-filter') === 'cnc');
      }

      furnFilterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          setTimeout(() => {
            if (isAnyTagFilterActive() || isCncFilterActive()) {
              moreBtn.style.display = 'none';
              collapseBtn.style.display = 'none';
            } else {
              resetGrid();
            }
          }, 10);
        });
      });

      filterBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          setTimeout(() => {
            if (isCncFilterActive()) {
              moreBtn.style.display = 'none';
              collapseBtn.style.display = 'none';
            } else if (!isAnyTagFilterActive()) {
              resetGrid();
            }
          }, 10);
        });
      });
    })();
  </script>
