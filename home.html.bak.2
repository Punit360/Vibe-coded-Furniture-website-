<script>
  // ===== MOBILE PRODUCT BUTTONS: Make BUY and Add to cart work like PC =====
  document.addEventListener('DOMContentLoaded', function () {
    if (window.innerWidth <= 768) {
      // BUY button opens modal
      document.querySelectorAll('.buy, .buy-btn, .btn-primary').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          document.getElementById('orderModal').classList.add('show');
        });
      });
      // Add to cart button
      document.querySelectorAll('.cart, .add-to-cart, .btn-outline').forEach(btn => {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          // Simulate add to cart (you can add your cart logic here)
          alert('Added to cart!');
        });
      });
    }
  });
  // Internet connectivity check
  if (!navigator.onLine) {
    document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;font-size:22px;color:#c62828;background:#fff;">No internet connection. Please check your connection and reload the page.</div>';
    throw new Error('No internet connection');
  }
  window.addEventListener('offline', function () {
    document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;font-size:22px;color:#c62828;background:#fff;">No internet connection. Please check your connection and reload the page.</div>';
  });
</script>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Funiro — Furniture & Home Decor</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="home css.css" />

  <style>
    :root {
      --accent: #c28b4e;
      --text: #222;
      --muted: #666;
      --line: #eaeaea;
      --bg: #f8f8f8;
      --white: #fff;
      --danger: #c62828;
      --success: #2e7d32;
      --gold: #c9983a;
    }

    /* ===== MODAL STYLES ===== */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      display: none;
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }

    .modal-overlay.show {
      display: flex;
    }

    .modal {
      z-index: 1001;
    }

    .modal * {
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif
    }

    .modal .card {
      width: 900px;
      background: #fff;
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .modal .header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 15px;
    }

    .modal .container {
      display: flex;
      gap: 30px;
    }

    .modal .left,
    .modal .right {
      flex: 1
    }

    .modal .product-img {
      width: 100%;
      height: 260px;
      border: 1px solid #ccc;
      border-radius: 10px;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #777;
    }

    .modal .upload-box {
      border: 2px dashed #999;
      border-radius: 12px;
      margin-top: 15px;
      padding: 20px;
      text-align: center;
      background: #f2f2f2;
    }

    .modal .upload-box button {
      margin-top: 10px;
      padding: 8px 20px;
      border: none;
      border-radius: 20px;
      background: #ccc;
      cursor: pointer;
    }

    .modal .preview-row {
      display: flex;
      gap: 10px;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .modal .preview {
      width: 50px;
      height: 50px;
      border: 1px solid #ccc;
      border-radius: 8px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f9f9f9;
      font-size: 12px;
      color: #777;
    }

    .modal .preview img {
      width: 100%;
      height: 100%;
      border-radius: 8px;
    }

    .modal .right h3 {
      margin: 0
    }

    .modal .dotted {
      border-bottom: 2px dotted #000;
      margin: 10px 0
    }

    .modal .field {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #eee;
      padding: 6px 10px;
      border-radius: 6px;
      margin-bottom: 10px;
    }

    .modal .stepper {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .modal .stepper button {
      width: 22px;
      height: 22px;
      border: 1px solid #aaa;
      background: #fff;
      cursor: pointer;
      border-radius: 3px;
    }

    .modal .link-box {
      margin-top: 15px;
    }

    .modal .link-box input {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
      margin-top: 8px;
    }

    .modal .whatsapp {
      margin-top: 15px;
    }

    .modal .whatsapp button {
      width: 100%;
      padding: 10px;
      background: #25D366;
      color: #fff;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
    }

    /* ===== HIDE DESKTOP ON MOBILE ===== */
    @media (max-width: 768px) {
      .mobile-products {
        padding: 16px;
      }

      .product-scroll-row {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 20px;
      }

      .product-scroll-row::-webkit-scrollbar {
        display: none;
      }

      .product-scroll-row .product-card {
        min-width: 290px;
        max-width: 90vw;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #eee;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        scroll-snap-align: start;
        margin-bottom: 12px;
      }

      .product-media {
        position: relative;
        width: 100%;
        height: 180px;
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .product-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .like-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #fff;
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-size: 18px;
        color: #b88e2f;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
        cursor: pointer;
        z-index: 2;
      }

      .product-body {
        padding: 18px 16px 10px 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }

      .product-name {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #181818;
        text-align: left;
      }

      .product-desc {
        font-size: 15px;
        color: #444;
        margin-bottom: 14px;
        text-align: left;
        line-height: 1.5;
      }

      .card-actions {
        display: flex;
        gap: 10px;
        margin-bottom: 0;
      }

      .btn-primary,
      .buy-btn {
        background: #b88e2f;
        color: #fff;
        padding: 8px 0;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        flex: 1;
        font-size: 16px;
        box-shadow: 0 1px 4px rgba(184, 142, 47, 0.08);
        transition: background 0.2s;
      }

      .btn-primary:active,
      .buy-btn:active {
        background: #a67c1d;
      }

      .btn-outline,
      .add-to-cart {
        background: #fff;
        border: 1.5px solid #b88e2f;
        color: #b88e2f;
        padding: 8px 0;
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        flex: 1;
        font-size: 16px;
        transition: background 0.2s, color 0.2s;
      }

      .btn-outline:active,
      .add-to-cart:active {
        background: #b88e2f;
        color: #fff;
      }

      .pill {
        background: #f5f5f5;
        color: #b88e2f;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
        margin-left: 8px;
        align-self: center;
      }

      .product-tag-label {
        text-align: right;
        margin-top: 12px;
      }

      .product-tag-label span {
        background: #f5f5f5;
        color: #b88e2f;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 500;
      }


    }

    body {
      background: #fff !important;
    }

    /* Hide desktop header (the one with background-image style) */
    header[style*="background-image"] {
      display: none !important;
      visibility: hidden !important;
    }

    /* Hide desktop footer */
    footer.section {
      display: none !important;
      visibility: hidden !important;
    }

    @media (max-width: 768px) {

      /* Hide desktop products */
      .desktop-products {
        display: none !important;
      }

      .mobile-products {
        padding: 16px;
      }

      .product-scroll-row {
        display: flex;
        gap: 14px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        margin-bottom: 20px;
      }

      .product-scroll-row::-webkit-scrollbar {
        display: none;
      }

      .product-card {
        min-width: 260px;
        max-width: 90vw;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
        border: 1px solid #eee;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        margin-bottom: 8px;
        scroll-snap-align: start;
        position: relative;
      }

      .product-img {
        width: 100%;
        height: 160px;
        background: #eee;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
      }

      .product-info {
        padding: 16px 14px 12px 14px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }

      .product-info h4 {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 6px;
        color: #181818;
        text-align: left;
      }

      .product-info p {
        font-size: 15px;
        color: #444;
        margin-bottom: 14px;
        text-align: left;
        line-height: 1.5;
      }

      .actions {
        display: flex;
        gap: 10px;
        margin-bottom: 8px;
      }

      .buy {
        background: #b88e2f;
        color: #fff;
        padding: 8px 0;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        flex: 1;
        font-size: 16px;
        box-shadow: 0 1px 4px rgba(184, 142, 47, 0.08);
        transition: background 0.2s;
      }

      .buy:active {
        background: #a67c1d;
      }

      .cart {
        background: #fff;
        border: 1.5px solid #b88e2f;
        color: #b88e2f;
        padding: 8px 0;
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        flex: 1;
        font-size: 16px;
        transition: background 0.2s, color 0.2s;
      }

      .cart:active {
        background: #b88e2f;
        color: #fff;
      }

      .product-tag-label {
        position: absolute;
        right: 14px;
        bottom: 14px;
        background: #f5f5f5;
        color: #b88e2f;
        font-size: 15px;
        font-weight: 500;
        padding: 4px 16px;
        border-radius: 18px;
        box-shadow: 0 1px 4px rgba(184, 142, 47, 0.08);
        border: none;
        pointer-events: none;
      }

      .product-scroll-row {
        gap: 18px;
        padding-bottom: 8px;
      }

      .mobile-products {
        display: block;
      }
    }

    /* ===== SHOW DESKTOP ON DESKTOP VIEW ===== */
    @media (min-width: 769px) {

      /* Hide mobile header (first header without background-image) */
      body>header:not([style*="background-image"]) {
        display: none !important;
        visibility: hidden !important;
      }

      #pcMoreBtnWrap {
        display: flex !important;
        justify-content: center;
        margin-top: 20px;
      }

      /* Hide mobile footer */
      footer:not(.section) {
        display: none !important;
        visibility: hidden !important;
      }

      /* Hide mobile sections */
      .hero,
      .peace,
      .about,
      .contact-item,
      .tabs,
      .icon-filters,
      .dot,
      section:not(#home):not(#about):not(#range):not(#shop):not(.section) {
        display: none !important;
        visibility: hidden !important;
      }

      /* Show desktop sections */
      #home,
      #about,
      #range,
      #shop,
      .inspiration,
      footer.section,
      #pcMoreBtnWrap {
        display: block !important;
        visibility: visible !important;
      }

      #pcMoreBtnWrap {
        display: flex !important;
        justify-content: center;
        text-align: center;
        margin: 26px 0;
      }

      /* Show desktop header */
      header[style*="background-image"] {
        display: block !important;
        visibility: visible !important;
      }
    }

    /* ===== MOBILE STYLES (MAX-WIDTH 768PX) ===== */
    @media (max-width: 768px) {
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0
      }

      body {
        background: #fff !important
      }

      /* Explicitly show mobile elements */
      body>header:first-of-type,
      .hero,
      section,
      .peace,
      .about,
      .contact-item,
      footer {
        display: block !important;
        visibility: visible !important;
      }

      /* ===== MOBILE HEADER ===== */
      body>header:first-of-type {
        position: sticky;
        top: 0;
        z-index: 10;
        background: #fff url('./assets/logo/header-bg.jpg') center/cover no-repeat;
        border-bottom: 1px solid #e5e5e5;
        padding: 12px 16px;
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        min-height: 64px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0px
      }

      .brand-logo {
        width: 50px;
        height: 50px
      }

      .brand-divider {
        width: 2px;
        height: 36px;
        background: #000;
        margin: 0 10px;
      }

      .brand-text {
        font-weight: 600;
        line-height: 1.1;
        color: var(--gold);
        font-size: 16px;
        margin-left: 0;
      }

      .brand-text span {
        display: block;
        font-size: 12px;
        color: var(--gold)
      }

      /* Make mobile BUY and Add to cart buttons work like PC */
      .buy,
      .buy-btn,
      .btn-primary {
        /* already styled above, just ensure pointer */
        cursor: pointer;
      }

      .cart,
      .add-to-cart,
      .btn-outline {
        cursor: pointer;
      }

      .icons {
        display: flex;
        gap: 10px
      }

      .icon {
        width: 30px;
        height: 30px;
        border: 1px solid var(--line);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center
      }

      /* ===== HERO ===== */
      .hero {
        padding: 16px
      }

      .hero-wrap {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        align-items: center
      }

      .hero-track {
        display: flex;
        width: 100%;
        transition: transform 0.8s ease-in-out
      }

      .hero-img {
        min-width: 100%;
        height: 240px;
        background: #ddd;
        display: flex;
        align-items: center;
        justify-content: center
      }

      .hero-img img {
        width: 100%;
        height: 100%;
        object-fit: cover
      }

      .hero-text {
        position: absolute;
        right: 16px;
        bottom: 16px;
        font-size: 34px;
        font-weight: 600;
        color: var(--gold);
        line-height: 1;
        z-index: 5
      }

      .hero-nav {
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        display: flex;
        justify-content: space-between;
        padding: 0 10px;
        z-index: 20
      }

      .hero-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #ddd;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 18px;
        font-family: inherit;
        transition: all 0.3s
      }

      .hero-btn:active {
        background: var(--gold);
        color: #fff;
        border-color: var(--gold)
      }

      .hero-dots {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 10px;
        padding: 0 16px
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ddd;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.3s ease-in-out;
        font-family: inherit
      }

      .dot.active {
        background: var(--gold);
        width: 20px;
        border-radius: 4px;
        animation: dotPulse 0.3s ease-in-out
      }

      /* ===== MOBILE MODAL OVERRIDE ===== */
      .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        justify-content: center;
        align-items: center;
      }

      .modal .card {
        width: 95vw;
        max-width: 500px;
        padding: 15px;
        border-radius: 12px;
      }

      .modal .container {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }

      .modal .left,
      .modal .right {
        flex: 1;
      }

      .modal .product-img {
        height: 200px;
      }

      .modal .header {
        margin-bottom: 10px;
      }

      /* ===== SECTIONS ===== */
      section {
        padding: 28px 16px
      }

      h2 {
        text-align: center;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 20px
      }

      /* ===== BROWSE RANGE ===== */
      .scroll-row {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        padding-bottom: 6px
      }

      .scroll-row::-webkit-scrollbar {
        display: none
      }

      .range-card {
        min-width: 85%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column
      }

      .range-img {
        height: 140px;
        flex-shrink: 0;
        overflow: hidden
      }

      .range-img img {
        width: 100%;
        height: 100%;
        object-fit: cover
      }

      .range-content {
        text-align: center;
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column
      }

      .range-content h3 {
        font-size: 18px;
        margin-bottom: 6px
      }

      .range-content p {
        font-size: 14px;
        color: #666;
        margin-bottom: 12px;
        flex: 1
      }

      .btn {
        background: var(--gold);
        color: #fff;
        padding: 10px 22px;
        border-radius: 22px;
        font-size: 14px;
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        transition: all 0.3s
      }

      .btn:active {
        background: #b8752c
      }




      /* ===== OUR PRODUCTS ===== */
      .subtitle {
        text-align: center;
        color: #666;
        margin-top: -10px;
        margin-bottom: 20px;
        font-size: 14px
      }

      .tabs {
        text-align: center;
        font-size: 17px;
        font-weight: 500;
        margin-bottom: 20px
      }

      .tabs span {
        margin: 0 10px;
        padding-bottom: 6px;
        cursor: pointer;
        transition: all 0.3s
      }

      .tabs span.active {
        border-bottom: 3px solid var(--gold);
        color: var(--gold)
      }

      .icon-filters {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        text-align: center;
        margin-bottom: 24px;
        padding: 0 3px
      }

      .icon-box {
        font-size: 13px;
        cursor: pointer
      }

      .icon-img {
        width: 58px;
        height: 44px;
        margin: 5px
      }

      .icon-box.active span {
        border-bottom: 2px solid var(--gold);
        color: var(--gold);
        padding-bottom: 4px;
        display: block
      }

      /* GLOBAL PC STYLES FOR INNER PEACE (Hidden on mobile via media query) */
      section.peace-pc {
        display: grid !important;
        visibility: visible !important;
        opacity: 1 !important;
        grid-template-columns: 1fr 1.1fr;
        column-gap: 28px;
        align-items: center;
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 20px !important;
        background: linear-gradient(180deg, #fff 0%, #faf7f0 100%) !important;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        position: relative;
      }

      .peace-pc h2 {
        grid-column: 1 / 2;
        grid-row: 1;
        margin: 0 0 8px !important;
        font-size: 30px !important;
        text-align: left !important;
      }

      .peace-pc p:nth-of-type(1) {
        grid-column: 1 / 2;
        grid-row: 2;
        margin: 0 0 16px !important;
        font-size: 16px !important;
        color: var(--muted) !important;
        line-height: 1.6;
      }

      .peace-pc .btn {
        grid-column: 1 / 2;
        grid-row: 3;
        width: fit-content;
        background: #c9983a !important;
        /* Gold color */
        color: #fff !important;
        border: none;
        padding: 12px 24px;
        font-size: 16px;
        border-radius: 6px;
        cursor: pointer;
        margin-top: 8px;
      }

      /* Place slider in right column */
