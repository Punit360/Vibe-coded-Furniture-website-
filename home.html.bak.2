<!-- MOBILE-ONLY PRODUCT FILTERING & MORE BUTTON LOGIC -->
<script>
  // MOBILE: Show PC product cards inside the scroll-row and ensure More button visibility
  function showMobileRows() {
    try {
      const grid = document.getElementById('productsGrid');
      if (!grid) return;
      // remember original shop location so we can restore on desktop
      if (typeof window._shopOriginalParent === 'undefined') {
        const shopEl = document.getElementById('shop');
        if (shopEl) {
          window._shopOriginalParent = shopEl.parentNode;
          window._shopOriginalNext = shopEl.nextSibling;
        }
      }
      const more = document.getElementById('moreProductsBtn');
      const collapse = document.getElementById('collapseBtn');

      if (isMobile()) {
        // apply scroll-row styles (kept in CSS as well) to ensure cards are visible on mobile
        grid.classList.add('product-scroll-row');
        grid.style.display = 'flex';
        grid.style.overflowX = 'auto';
        grid.style.flexWrap = 'nowrap';
        grid.style.gap = '16px';
        // make sure each PC product card is visible
        grid.querySelectorAll('.product-card').forEach(card => {
          card.style.display = 'block';
          card.style.flex = '0 0 290px';
          card.style.minWidth = '290px';
          card.style.maxWidth = '';
          card.style.margin = '0 8px';
        });
        // show More/Collapse controls
        if (more) more.style.display = '';
        if (collapse) collapse.style.display = 'none';
        // move #range then #shop directly after the hero on mobile (order: hero -> range -> shop)
        try {
          const shopEl = document.getElementById('shop');
          const rangeEl = document.getElementById('range');
          const heroEl = document.querySelector('.hero');
          if (rangeEl && heroEl && rangeEl !== heroEl.nextSibling) {
            heroEl.parentNode.insertBefore(rangeEl, heroEl.nextSibling);
          }
          if (shopEl && rangeEl && shopEl !== rangeEl.nextSibling) {
            rangeEl.parentNode.insertBefore(shopEl, rangeEl.nextSibling);
          } else if (shopEl && heroEl && shopEl !== heroEl.nextSibling) {
            // fallback: if range not present, place shop after hero
            heroEl.parentNode.insertBefore(shopEl, heroEl.nextSibling);
          }
        } catch (e) {
          console.warn('move shop/range error', e);
        }
      } else {
        // revert any mobile-specific inline styles when on desktop
        grid.classList.remove('product-scroll-row');
        grid.style.display = '';
        grid.style.overflowX = '';
        grid.style.flexWrap = '';
        grid.style.gap = '';
        grid.querySelectorAll('.product-card').forEach(card => {
          card.style.display = '';
          card.style.flex = '';
          card.style.minWidth = '';
          card.style.maxWidth = '';
          card.style.margin = '';
        });
        if (more) more.style.display = '';
        if (collapse) collapse.style.display = 'none';
        // restore #shop to original location on desktop
        try {
          const shopEl = document.getElementById('shop');
          if (shopEl && window._shopOriginalParent && shopEl.parentNode !== window._shopOriginalParent) {
            window._shopOriginalParent.insertBefore(shopEl, window._shopOriginalNext || null);
          }
        } catch (e) {
          console.warn('restore shop error', e);
        }
      }
      // Also convert PC "Browse The Range" grid into a mobile scroll-row when on small screens
      try {
        const rangeGrid = document.querySelector('#range .range-grid');
        if (rangeGrid && window.innerWidth <= 768) {
          rangeGrid.classList.add('scroll-row');
          rangeGrid.style.display = 'flex';
          rangeGrid.style.overflowX = 'auto';
          rangeGrid.style.flexWrap = 'nowrap';
          rangeGrid.style.gap = '16px';
          rangeGrid.querySelectorAll('.range-card').forEach(card => {
            card.style.minWidth = '85%';
            card.style.maxWidth = '90vw';
            card.style.marginRight = '12px';
          });
        } else if (rangeGrid) {
          // revert inline styles on larger screens
          rangeGrid.classList.remove('scroll-row');
          rangeGrid.style.display = '';
          rangeGrid.style.overflowX = '';
          rangeGrid.style.flexWrap = '';
          rangeGrid.style.gap = '';
          rangeGrid.querySelectorAll('.range-card').forEach(card => {
            card.style.minWidth = '';
            card.style.maxWidth = '';
            card.style.marginRight = '';
          });
        }
      } catch (e) {
        console.warn('rangeGrid conversion error', e);
      }
    } catch (e) {
      console.warn('showMobileRows error', e);
    }
  }

  // Run on load and on resize to keep grid in scroll mode on mobile
  document.addEventListener('DOMContentLoaded', showMobileRows);
  window.addEventListener('resize', showMobileRows);
</script>

