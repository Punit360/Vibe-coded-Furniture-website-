          // Show user initial in a circle
          const email = getUserEmail();
          const initial = email.charAt(0).toUpperCase();
          loginLogoutBtn.innerHTML = `<span style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:#111;color:#fff;font-size:20px;font-weight:600;border:2px solid #111;">${initial}</span>`;
          loginLogoutBtn.onclick = function (e) {
            e.stopPropagation();
            // Toggle dropdown
            userMenu.style.display = userMenu.style.display === 'block' ? 'none' : 'block';
          };
        } else {
          loginLogoutBtn.innerHTML = 'LOGIN';
          loginLogoutBtn.onclick = function () {
            window.location.href = 'login-signup.html';
          };
          userMenu.style.display = 'none';
        }
      }
      updateLoginLogoutBtn();
      window.addEventListener('storage', updateLoginLogoutBtn);

      // Hide dropdown on click outside
      document.addEventListener('click', function (e) {
        if (userMenu.style.display === 'block' && !userMenu.contains(e.target) && e.target !== loginLogoutBtn) {
          userMenu.style.display = 'none';
        }
      });
      // Logout button in dropdown
      userMenu.addEventListener('click', function (e) {
        if (e.target && e.target.id === 'logoutBtnDropdown') {
          localStorage.removeItem('token');
          localStorage.removeItem('role');
          localStorage.removeItem('userEmail');
          userMenu.style.display = 'none';
          updateLoginLogoutBtn();
        }
      });

      // Cart products tray logic
      const cartTray = document.getElementById('cartTray');
      const cartCardsList = document.getElementById('cartCardsList');
      const cartHeaderBtn = document.getElementById('cartHeaderBtn');
      const closeCartTray = document.getElementById('closeCartTray');
      let cartProducts = JSON.parse(localStorage.getItem('cartProducts') || '[]');

      function renderCartTray() {
        cartCardsList.innerHTML = '';
        if (!cartProducts.length) {
          cartCardsList.innerHTML = '<div style="color:var(--muted,#888);text-align:center;padding:18px 0;">No products in cart.</div>';
          return;
        }
        cartProducts.forEach(function (prod) {
          const div = document.createElement('div');
          div.style.display = 'flex';
          div.style.alignItems = 'center';
          div.style.gap = '10px';
          div.style.background = 'var(--bg-2,#fafafa)';
          div.style.borderRadius = '8px';
          div.style.padding = '7px 10px';
          div.innerHTML = `
        <img src="${prod.img}" alt="${prod.name}" style="width:44px;height:44px;object-fit:cover;border-radius:7px;border:1px solid #eee;">
        <div style="flex:1;">
          <div style="font-weight:500;font-size:15px;">${prod.name}</div>
          <div style="font-size:12px;color:var(--muted,#888);">${prod.tag}</div>
        </div>
        <button class="remove-cart-btn" data-id="${prod.id}" style="background:none;border:none;color:#c62828;font-size:18px;cursor:pointer;">&times;</button>
      `;
          cartCardsList.appendChild(div);
        });
        // Remove cart product
        cartCardsList.querySelectorAll('.remove-cart-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            cartProducts = cartProducts.filter(p => p.id !== btn.getAttribute('data-id'));
            localStorage.setItem('cartProducts', JSON.stringify(cartProducts));
            renderCartTray();
            // Also update add-to-cart button state
            document.querySelectorAll('.add-to-cart').forEach(function (cartBtn) {
              if ((cartBtn.closest('.product-card')?.getAttribute('data-id') || cartBtn.closest('.product-card')?.querySelector('.product-name')?.textContent?.trim().replace(/\s+/g, '-').toLowerCase()) === btn.getAttribute('data-id')) {
                cartBtn.textContent = 'Add to cart';
                cartBtn.classList.remove('added');
              }
            });
          });
        });
        // Add single Buy All button if there are products
        if (cartProducts.length) {
          const buyAllDiv = document.createElement('div');
          buyAllDiv.style.textAlign = 'center';
          buyAllDiv.style.marginTop = '16px';
          buyAllDiv.innerHTML = '<button class="btn-primary" id="buyAllBtn" style="width:90%;font-size:16px;padding:10px 0;display:block;margin:0 auto;text-align:center;">Buy All</button>';
          cartCardsList.appendChild(buyAllDiv);
          document.getElementById('buyAllBtn').addEventListener('click', function () {
            window.location.href = 'login-signup.html';
          });
        }
      }

      cartHeaderBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        cartTray.style.display = cartTray.style.display === 'none' ? 'block' : 'none';
        renderCartTray();
      });
      closeCartTray.addEventListener('click', function () {
        cartTray.style.display = 'none';
      });
      document.addEventListener('click', function (e) {
        if (cartTray.style.display === 'block' && !cartTray.contains(e.target) && e.target !== cartHeaderBtn) {
          cartTray.style.display = 'none';
        }
      });

      // Add to cart button logic
      document.querySelectorAll('.add-to-cart').forEach(function (btn) {
        const card = btn.closest('.product-card');
        // Assign a unique id to each card if not present
        if (card && !card.getAttribute('data-id')) {
          card.setAttribute('data-id', getProductInfo(card).id);
        }
        // Set initial cart state
        if (card && cartProducts.some(p => p.id === card.getAttribute('data-id'))) {
          btn.textContent = 'Added in cart';
          btn.classList.add('added');
        }
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (!card) return;
          const prod = getProductInfo(card);
          const idx = cartProducts.findIndex(p => p.id === prod.id);
          if (idx === -1) {
            cartProducts.push(prod);
            btn.textContent = 'Added in cart';
            btn.classList.add('added');
          } else {
            cartProducts.splice(idx, 1);
            btn.textContent = 'Add to cart';
            btn.classList.remove('added');
          }
          localStorage.setItem('cartProducts', JSON.stringify(cartProducts));
          renderCartTray();
        });
      });
      const likedTray = document.getElementById('likedTray');
      const likedCardsList = document.getElementById('likedCardsList');
      const wishlistHeaderBtn = document.getElementById('wishlistHeaderBtn');
      const closeLikedTray = document.getElementById('closeLikedTray');
      let likedProducts = JSON.parse(localStorage.getItem('likedProducts') || '[]');

      // Helper to get product info from card
      function getProductInfo(card) {
        return {
          name: card.querySelector('.product-name')?.textContent?.trim() || '',
          img: card.querySelector('.product-media img')?.src || '',
          tag: card.querySelector('.product-tag-label span')?.textContent?.trim() || '',
          id: card.getAttribute('data-id') || card.querySelector('.product-name')?.textContent?.trim().replace(/\s+/g, '-').toLowerCase() || Math.random().toString(36).slice(2)
        };
      }

      // Render liked tray
      function renderLikedTray() {
        likedCardsList.innerHTML = '';
        if (!likedProducts.length) {
          likedCardsList.innerHTML = '<div style="color:var(--muted,#888);text-align:center;padding:18px 0;">No liked products yet.</div>';
          return;
        }
        likedProducts.forEach(function (prod) {
          const div = document.createElement('div');
          div.style.display = 'flex';
          div.style.alignItems = 'center';
          div.style.gap = '10px';
          div.style.background = 'var(--bg-2,#fafafa)';
          div.style.borderRadius = '8px';
          div.style.padding = '7px 10px';
          div.innerHTML = `
        <img src="${prod.img}" alt="${prod.name}" style="width:44px;height:44px;object-fit:cover;border-radius:7px;border:1px solid #eee;">
        <div style="flex:1;">
          <div style="font-weight:500;font-size:15px;">${prod.name}</div>
          <div style="font-size:12px;color:var(--muted,#888);">${prod.tag}</div>
        </div>
        <button class="remove-liked-btn" data-id="${prod.id}" style="background:none;border:none;color:#c62828;font-size:18px;cursor:pointer;">&times;</button>
      `;
          likedCardsList.appendChild(div);
        });
        // Remove liked product
        likedCardsList.querySelectorAll('.remove-liked-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            likedProducts = likedProducts.filter(p => p.id !== btn.getAttribute('data-id'));
            localStorage.setItem('likedProducts', JSON.stringify(likedProducts));
            renderLikedTray();
            // Also update like button state
            document.querySelectorAll('.like-btn').forEach(function (likeBtn) {
              if ((likeBtn.closest('.product-card')?.getAttribute('data-id') || likeBtn.closest('.product-card')?.querySelector('.product-name')?.textContent?.trim().replace(/\s+/g, '-').toLowerCase()) === btn.getAttribute('data-id')) {
                likeBtn.classList.remove('liked');
              }
            });
          });
        });
      }

      // Show/hide tray
      wishlistHeaderBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        likedTray.style.display = likedTray.style.display === 'none' ? 'block' : 'none';
        renderLikedTray();
      });
      closeLikedTray.addEventListener('click', function () {
        likedTray.style.display = 'none';
      });
      document.addEventListener('click', function (e) {
        if (likedTray.style.display === 'block' && !likedTray.contains(e.target) && e.target !== wishlistHeaderBtn) {
          likedTray.style.display = 'none';
        }
      });

      // Like button logic
      document.querySelectorAll('.like-btn').forEach(function (btn) {
        const card = btn.closest('.product-card');
        // Assign a unique id to each card if not present
        if (card && !card.getAttribute('data-id')) {
          card.setAttribute('data-id', getProductInfo(card).id);
        }
        // Set initial liked state
        if (card && likedProducts.some(p => p.id === card.getAttribute('data-id'))) {
          btn.classList.add('liked');
        }
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (!card) return;
          const prod = getProductInfo(card);
          const idx = likedProducts.findIndex(p => p.id === prod.id);
          if (idx === -1) {
            likedProducts.push(prod);
            btn.classList.add('liked');
          } else {
            likedProducts.splice(idx, 1);
            btn.classList.remove('liked');
          }
          localStorage.setItem('likedProducts', JSON.stringify(likedProducts));
          renderLikedTray();
        });
      });
    });
  </script>

