<script>
  document.addEventListener('DOMContentLoaded', function () {
    const exploreBtns = document.querySelectorAll('.explore-filter-btn');
    const productsSection = document.getElementById('shop');

    // Function to filter products by tag
    function filterProductsByTag(tag) {
      // Ensure specific furniture items are shown and CNC hidden if needed
      // Assuming 'furniture' is the default view.

      const allCards = document.querySelectorAll('.products-furniture .product-card');

      allCards.forEach(card => {
        const tags = card.getAttribute('data-tags');
        if (tags && tags.includes(tag)) {
          card.style.display = 'block';
          // Also remove 'hide' class if used by other filters
          card.classList.remove('hide');
        } else {
          card.style.display = 'none';
        }
      });

      // Also ensure the furniture section is visible
      const furnitureSection = document.querySelector('.products-furniture');
      const cncSection = document.querySelector('.products-cnc');
      if (furnitureSection) furnitureSection.style.display = '';
      if (cncSection) cncSection.style.display = 'none';

      // Hide "More" button if filtering
      const moreBtn = document.getElementById('moreProductsBtn');
      if (moreBtn) moreBtn.style.display = 'none';
    }

    exploreBtns.forEach(btn => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        const targetTag = this.getAttribute('data-filter-target');

        // Filter products
        filterProductsByTag(targetTag);

        // Scroll to shop section
        productsSection.scrollIntoView({ behavior: 'smooth' });
        // Activate the correct furniture filter button (underline)
        const furnFilterBtns = document.querySelectorAll('.furn-filter-btn');
        furnFilterBtns.forEach(fbtn => {
          if (fbtn.getAttribute('data-furn') === targetTag) {
            fbtn.classList.add('active');
          } else {
            fbtn.classList.remove('active');
          }
        });
      });
    });

    // Reset filter when clicking "Furniture" main filter or "Show All" if exists
    // We hook into existing filter buttons to reset our inline style overrides
    const mainFilterBtns = document.querySelectorAll('.filter-btn');
    mainFilterBtns.forEach(btn => {
      btn.addEventListener('click', function () {
        // If user clicks Furniture/CNC, we should reset the inline display styles 
        // on individual cards so the original logic takes over or shows all.
        const allCards = document.querySelectorAll('.products-furniture .product-card');
        allCards.forEach(card => {
          card.style.display = ''; // Clear inline display
        });

        // Re-show "More" button if needed (or let existing logic handle it)
        // Existing logic seems to handle pagination/more button.
        const moreBtn = document.getElementById('moreProductsBtn');
        if (moreBtn) moreBtn.style.display = '';
      });
    });

    // Modal functionality
    const modal = document.getElementById('orderModal');
    const closeModalBtn = document.getElementById('closeModal');
    const buyButtons = document.querySelectorAll('.buy-btn');
    let attachedFiles = []; // Store File objects for sharing

    buyButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        const card = btn.closest('.product-card');
        const productName = card.querySelector('.product-name').textContent;
        const productDesc = card.querySelector('.product-desc').textContent;
        const productImg = card.querySelector('.product-media img').src;
        const tags = card.getAttribute('data-tags') || '';
        const modalProductName = modal.querySelector('.right h3');
        const modalProductDesc = modal.querySelector('.right p');
        const modalProductImg = modal.querySelector('.product-img img');
        modalProductName.textContent = productName;
        modalProductDesc.textContent = productDesc;
        modalProductImg.src = productImg;
        modalProductImg.style.display = 'block';

        // Show chairs field if living or dining
        const chairsField = modal.querySelector('.chairs-field');
        if (tags.includes('living') || tags.includes('dining')) {
          chairsField.style.display = 'block';
        } else {
          chairsField.style.display = 'none';
        }

        // Reset values
        modal.querySelector('.quantity-value').textContent = '1';
        modal.querySelector('.height-value').textContent = '0';
        modal.querySelector('.width-value').textContent = '0';
        modal.querySelector('.chairs-value').textContent = '0';
        modal.querySelector('.link-input').value = '';
        modal.querySelector('.attached-links').innerHTML = '';
        modal.querySelector('.preview-row').innerHTML = '';
        attachedFiles = [];

        modal.classList.add('show');
      });
    });

    closeModalBtn.addEventListener('click', function () {
      modal.classList.remove('show');
    });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) {
        modal.classList.remove('show');
      }
    });

    // Stepper functionality
    modal.addEventListener('click', function (e) {
      if (e.target.classList.contains('stepper-btn')) {
        const valueEl = e.target.parentElement.querySelector('.value');
        let value = parseInt(valueEl.textContent);
        if (e.target.textContent === '+') {
          value++;
        } else if (e.target.textContent === '-' && value > 0) {
          value--;
        }
        valueEl.textContent = value;
      }
    });

    // Link confirm
    const linkConfirmBtn = modal.querySelector('.link-confirm');
    const linkInput = modal.querySelector('.link-input');
    const attachedLinks = modal.querySelector('.attached-links');

    linkConfirmBtn.addEventListener('click', function () {
      const link = linkInput.value.trim();
      if (link) {
        const linkDiv = document.createElement('div');
        linkDiv.className = 'preview';
        linkDiv.innerHTML = `<span>${link}</span><button class="remove-link" style="background:none;border:none;color:#000;font-size:12px;cursor:pointer;">×</button>`;
        attachedLinks.appendChild(linkDiv);
        linkInput.value = '';
      }
    });

    attachedLinks.addEventListener('click', function (e) {
      if (e.target.classList.contains('remove-link')) {
        e.target.parentElement.remove();
      }
    });

    // Image upload
    const uploadBtn = modal.querySelector('.upload-btn');
    const fileInput = modal.querySelector('.file-input');
    const uploadBox = modal.querySelector('.upload-box');
    const previewRow = modal.querySelector('.preview-row');

    function handleFiles(files) {
      const imageFiles = Array.from(files).filter(file => file.type.startsWith('image/'));
      imageFiles.forEach(file => {
        attachedFiles.push(file);
        const index = attachedFiles.length - 1;
        const reader = new FileReader();
        reader.onload = function (e) {
          const preview = document.createElement('div');
          preview.className = 'preview';
          preview.setAttribute('data-index', index);
          preview.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:8px;"><button class="remove-img" style="position:absolute;top:2px;right:2px;background:#000;color:#fff;font-size:12px;border-radius:50%;width:16px;height:16px;text-align:center;line-height:16px;border:none;cursor:pointer;z-index:1;">×</button>`;
          previewRow.appendChild(preview);
        };
        reader.readAsDataURL(file);
      });
    }

    uploadBtn.addEventListener('click', function () {
      fileInput.click();
    });

    fileInput.addEventListener('change', function () {
      handleFiles(this.files);
    });

    // Drag and drop
    uploadBox.addEventListener('dragover', function (e) {
      e.preventDefault();
      uploadBox.style.background = '#e0e0e0';
    });

    uploadBox.addEventListener('dragleave', function () {
      uploadBox.style.background = '#f2f2f2';
    });

    uploadBox.addEventListener('drop', function (e) {
      e.preventDefault();
      uploadBox.style.background = '#f2f2f2';
      handleFiles(e.dataTransfer.files);
    });

    previewRow.addEventListener('click', function (e) {
      if (e.target.classList.contains('remove-img')) {
        const preview = e.target.parentElement;
        const index = parseInt(preview.getAttribute('data-index'));
        attachedFiles.splice(index, 1);
        // Update indices for remaining previews
        const remainingPreviews = previewRow.querySelectorAll('.preview');
        remainingPreviews.forEach((p, i) => {
          p.setAttribute('data-index', i);
        });
        preview.remove();
      }
    });

    // WhatsApp continue
    const whatsappBtn = modal.querySelector('.whatsapp button');
    whatsappBtn.addEventListener('click', function () {
      const productName = modal.querySelector('.right h3').textContent;
      const quantity = modal.querySelector('.quantity-value').textContent;
      const height = modal.querySelector('.height-value').textContent;
      const width = modal.querySelector('.width-value').textContent;
      const chairs = modal.querySelector('.chairs-value').textContent;
      const links = Array.from(attachedLinks.querySelectorAll('.preview span')).map(span => span.textContent);

      const userEmail = localStorage.getItem('userEmail') || 'guest@example.com';
      const userName = userEmail.split('@')[0];

      let message = `Hello, I want to order:\n`;
      message += `Customer Name: ${userName}\n`;
      message += `Email: ${userEmail}\n`;
      message += `Product: ${productName}\n`;
      message += `Quantity: ${quantity}\n`;
      if (height !== '0') message += `Height: ${height} CM\n`;
      if (width !== '0') message += `Width: ${width} CM\n`;
      if (chairs !== '0') message += `Chairs: ${chairs}\n`;
      if (links.length) message += `Reference Links: ${links.join(', ')}\n`;

      if (navigator.share && attachedFiles.length > 0) {
        const shareData = {
          title: 'Product Order',
          text: message,
          files: attachedFiles
        };
        navigator.share(shareData).catch(err => {
          console.error('Share failed:', err);
          // Fallback to wa.me
          const phone = '916375969195';
          const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
          window.open(url, '_blank');
        });
      } else {
        const phone = '916375969195';
        const url = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
        window.open(url, '_blank');
      }
    });
  });
</script>

